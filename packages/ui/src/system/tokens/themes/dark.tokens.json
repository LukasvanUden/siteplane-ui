{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "semantic": {
    "color": {
      "$type": "color",
      "$description": "The grey text colours, the info colours, the focus colour and the primary colours alias the kit's role tokens in every theme (semantic.tokens.json), so this theme leaves them out.",
      "background": { "$value": "{primitive.color.background-dark}" },
      "surface": { "$value": "{primitive.color.surface-dark}" },
      "card": { "$value": "{primitive.color.surface-dark}" },
      "surface-muted": { "$value": "{primitive.color.white-alpha-4}" },
      "surface-subtle": { "$value": "{primitive.color.white-alpha-4}" },
      "muted": { "$value": "{primitive.color.white-alpha-4}" },
      "border": { "$value": "{primitive.color.white-alpha-6}" },
      "border-strong": { "$value": "{primitive.color.neutral-500}" },
      "primary-hover": { "$value": "{primitive.color.blue-100}" },
      "destructive": { "$value": "{primitive.color.red-500-dark}" },
      "destructive-hover": { "$value": "{primitive.color.red-100}" },
      "destructive-foreground": { "$value": "{primitive.color.red-400}" },
      "success": { "$value": "{primitive.color.green-500}" },
      "success-foreground": { "$value": "{primitive.color.green-400}" },
      "warning": { "$value": "{primitive.color.amber-500}" },
      "warning-foreground": { "$value": "{primitive.color.amber-400}" },
      "ring": { "$value": "{primitive.color.neutral-500}" },
      "input": { "$value": "{primitive.color.white-alpha-8}" },
      "control": { "$value": "{primitive.color.neutral-900}" },
      "control-hover": { "$value": "{primitive.color.neutral-800}" },
      "control-disabled": { "$value": "{primitive.color.neutral-800}" },
      "invalid": { "$value": "{primitive.color.red-500-dark}" },
      "invalid-muted": { "$value": "{primitive.color.neutral-800}" },
      "overlay-backdrop": { "$value": "{primitive.color.black-alpha-40}" }
    }
  }
}
